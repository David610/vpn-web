# /etc/arcana/api.env  -  root:arcana 0640. NEVER commit real values.
# Full dynamic API on one origin behind Nginx (no API_ROUTE_PREFIXES).
API_HOST=127.0.0.1
API_PORT=8787
TRUSTED_PROXY_HOPS=1
PUBLIC_API_ORIGIN=https://app.example.test
MAX_IN_FLIGHT=256
NODE_AUTH_TTL_MS=5000
METRICS_TOKEN=            # openssl rand -hex 24

# Core
SUPABASE_URL=https://lzpvxmstspaaltvqzctl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SITE_URL=https://app.example.test
SUBSCRIPTION_TOKEN_HASH_KEY=      # >=32 random chars
VPN_SECRETS_ENCRYPTION_KEY=       # 64 hex = 32 bytes; MUST equal the key that encrypted existing rows
EXTERNAL_AUTHORIZATION_ACK_MODE=legacy
REQUIRE_CLAIM_TOKEN=true
ROUTE_SIGNING_KEY_ID=
ROUTE_SIGNING_PRIVATE_KEY=
CF_PAGES_COMMIT_SHA=              # shown by /api/version; set to the deployed git sha

# Scheduled maintenance (pg_cron -> POST /api/internal/*-tick)
FLEET_TICK_SECRET=                # openssl rand -hex 32
RETENTION_TICK_SECRET=            # openssl rand -hex 32

# Billing: Stripe TEST mode only until live charges are approved
STRIPE_API_KEY=
STRIPE_SIGNING_SECRET=
STRIPE_PRICE_ID=
STRIPE_SEAT_PRICE_ID=

# Messaging
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=

# Fleet: automation stays OFF (no autoscaling / auto-replace without approval)
FEATURE_AUTO_NODE_SCALE=false
FEATURE_AUTO_NODE_REPLACE=false
FEATURE_AUTO_NODE_HEALTH=false
FLEET_DNS_PROVIDER=cloudflare
FLEET_NODE_DOMAIN=
CLOUDFLARE_DNS_API_TOKEN=         # Zone.DNS:Edit on the node zone only
CLOUDFLARE_DNS_ZONE_ID=
