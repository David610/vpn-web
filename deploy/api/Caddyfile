{
	servers {
		# Cloudflare edge ranges (https://www.cloudflare.com/ips-v4, /ips-v6;
		# fetched 2026-10-16 - refresh when Cloudflare changes them). Only a
		# peer in these ranges may assert the client address via CF-Connecting-IP.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

{$API_DOMAIN} {
	encode zstd gzip
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 1MB
	}
	reverse_proxy api:8787 {
		# Replace, never append: the API trusts exactly one proxy hop.
		header_up X-Forwarded-For {client_ip}
		# Long polls (<= 30 s) must not be buffered.
		flush_interval -1
		transport http {
			response_header_timeout 45s
		}
	}
}
