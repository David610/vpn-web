# Copy to .dev.vars for local `wrangler pages dev` runs (gitignored — never
# commit real values). Task 1 (the webhook handler) never makes a real
# network call to Stripe, so STRIPE_API_KEY here can be any syntactically
# plausible placeholder for local testing. STRIPE_SIGNING_SECRET, however,
# MUST match whatever secret your local test script signs synthetic events
# with (see Task 1 Step 8) — they are the same shared secret on both sides
# of a real integration, just simulated locally here.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=<paste the SERVICE_ROLE_KEY your local `npx supabase start` prints>
STRIPE_API_KEY=sk_test_placeholder_not_a_real_key
# The Dashboard's webhook endpoint (or your local `stripe listen` forward)
# must be subscribed to exactly these event types for this integration to
# work: checkout.session.completed, invoice.paid,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_SIGNING_SECRET=whsec_test_local_secret_for_synthetic_events_only
STRIPE_PRICE_ID=price_placeholder_not_real
# Licensed recurring price for seats beyond the 3 included in the base
# price. Without it, /api/account/seats returns 503 and every account is
# capped at 3 seats.
STRIPE_SEAT_PRICE_ID=price_seat_xxx
SITE_URL=http://127.0.0.1:8788

# VPS provisioning agent (docs/superpowers/specs/2026-09-21-vpn-provisioning-agent-design.md)
VPN_SECRETS_ENCRYPTION_KEY=<64 hex chars — generate with `openssl rand -hex 32`, real value only in production>
RESEND_API_KEY=<paste from Resend dashboard>
# onboarding@resend.dev works without a verified domain, for local/test
# sends only — replace with a real from-address once a domain exists.
ALERT_FROM_EMAIL=onboarding@resend.dev

# Telegram identity linking + Mini App (docs/FLEET_PLATFORM_PLAN.md Phase 13).
# HMAC secret for verifying Mini App initData — see functions/lib/telegram-init-data.js.
# Never commit a real value; without it every Telegram-authenticated request fails closed.
TELEGRAM_BOT_TOKEN=123456:test-placeholder-not-a-real-bot-token

# Automated fleet provisioning (docs/NODE_BOOTSTRAP.md). All optional: without
# them the admin can still register nodes manually, but provider-backed node
# creation refuses with a 400.
HETZNER_API_TOKEN=<Hetzner Cloud project token — ideally a dedicated project>
# Token scoped to Zone.DNS:Edit on the node zone ONLY (never the deploy token).
CLOUDFLARE_DNS_API_TOKEN=<cloudflare dns-edit token>
CLOUDFLARE_DNS_ZONE_ID=<zone id of the domain that holds FLEET_NODE_DOMAIN>
# Nodes are published as <nodeId>.<FLEET_NODE_DOMAIN>, e.g. de-fsn-001.nodes.example.com
FLEET_NODE_DOMAIN=nodes.example.com
# Pinned singbox-vpn release every new node installs (must ship vpn-provisioning-agent).
FLEET_SINGBOX_VPN_VERSION=v1.1.0-rc.2
# Shared secret the Supabase pg_cron reconciler presents to /api/internal/fleet-tick
# (openssl rand -hex 32). scripts/setup-fleet-cron.mjs stores it in Supabase Vault.
FLEET_TICK_SECRET=<64 hex chars>
